# Supply-chain hardening (docs/CI_SECURITY_GATES.md). Applies to local installs, CI and the image build.
# No dependency lifecycle scripts run at install time (only fsevents, an optional macOS dev dependency,
# declares one, and it ships prebuilt binaries).
ignore-scripts=true
# Resolve only versions published at least 7 days ago (`npm ci` installs the reviewed lockfile as is).
min-release-age=7

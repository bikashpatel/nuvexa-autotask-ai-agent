# =============================================================================================
# NUVEXA-AutoTask-AI-Agent — environment configuration template
#
#   cp .env.example .env
#
# Every variable maps to a field of app/core/config.py::Settings (name upper-cased).
# The uncommented values below run the full demo with NO external credentials:
# synthetic mailbox, deterministic heuristic agent, mock Azure DevOps.
# Commented lines show the built-in default; uncomment only what you need to change.
#
# Rules:
#   * Never commit .env. Placeholders look like <your-...>; replace them, do not ship them.
#   * Do not leave a variable uncommented with an empty value (e.g. `LLM_TEMPERATURE=`):
#     empty strings are parsed as values and can fail validation. Comment it out instead.
#   * Lists are comma-separated (CORS_ALLOWED_ORIGINS, ENTRA_ALLOWED_TENANT_IDS, ...).
#   * In production put secrets in Azure Key Vault, not in files (docs/deployment.md).
# =============================================================================================

# --- Application ------------------------------------------------------------------------------
# development | test | production. production enforces TOKEN_ENCRYPTION_KEYS, AUDIT_HMAC_KEY, secure
# cookies and https CORS origins, and disables demo login.
APP_ENV=development
# APP_NAME=NUVEXA-AutoTask-AI-Agent
# Public URL of the dashboard (post-login redirects). Default suits the Vite dev server (:5173).
# docker-compose.yml sets http://localhost:${NUVEXA_WEB_PORT:-8080} unless you override it here.
# APP_BASE_URL=http://localhost:5173
# Demo mode: synthetic mailbox + demo personas (demo login is never available in production).
DEMO_MODE=true
# OpenAPI docs at /api/docs. Unset = enabled except when APP_ENV=production.
# EXPOSE_API_DOCS=true
LOG_LEVEL=INFO
# json | console (console is easier to read locally).
LOG_FORMAT=json
# Keep false. When true, email content may appear in logs (local debugging only).
LOG_EMAIL_CONTENT=false

# --- Database ---------------------------------------------------------------------------------
# Default matches the compose Postgres published on localhost:5432 (option C in the README).
# docker-compose.yml always overrides this for its containers; `nuvexa demo` uses SQLite.
# DATABASE_URL=postgresql+psycopg://nuvexa:nuvexa@localhost:5432/nuvexa
# DATABASE_ECHO=false
# DATABASE_POOL_SIZE=5
# Per-connection PostgreSQL limits in milliseconds (0 disables).
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_LOCK_TIMEOUT_MS=10000

# --- HTTP / session security ------------------------------------------------------------------
# SESSION_COOKIE_NAME=nuvexa_session
# CSRF_COOKIE_NAME=nuvexa_csrf
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=120
# Unset = Secure cookies everywhere except APP_ENV=development. Cannot be false in production.
# COOKIE_SECURE=true
# Empty = CORS disabled (the dashboard is same-origin through the nginx / Vite proxy).
# Exact origins only (scheme://host[:port]); "*", "null", paths and wildcards are rejected at startup.
# CORS_ALLOWED_ORIGINS=https://<your-dashboard-host>
# MAX_REQUEST_BYTES=1048576
# RATE_LIMIT_ENABLED=true
# Proxy IPs whose X-Forwarded-* headers `nuvexa api` (uvicorn) trusts. Read from the process
# environment, not by Settings (on the host, export it; .env applies only inside compose).
# Default 127.0.0.1; docker-compose.yml sets * for the API behind the nginx frontend.
# FORWARDED_ALLOW_IPS=127.0.0.1
#
# Fernet keys that encrypt stored Microsoft tokens. Required in production and as soon as a real
# mailbox (MAIL_MODE=graph) or AZURE_DEVOPS_MODE=entra_delegated is used. Not needed for the demo.
# Generate:  uv run nuvexa gen-key     (or: docker compose run --rm api nuvexa gen-key)
# Rotation:  prepend the new key — the FIRST key encrypts, ALL keys decrypt.
# TOKEN_ENCRYPTION_KEYS=<your-new-fernet-key>,<your-previous-fernet-key>
#
# HMAC key (>= 32 characters) that makes every audit event tamper-evident
# (GET /api/v1/audit-events/integrity verifies them). Required in production; development falls back to a
# built-in key and logs a warning. Generate e.g. with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUDIT_HMAC_KEY=<your-audit-hmac-key>

# --- AI provider ------------------------------------------------------------------------------
# heuristic (offline, deterministic) | openai | azure_openai
LLM_PROVIDER=heuristic
# Model name for LLM_PROVIDER=openai (required there). Must support structured outputs + tools.
# LLM_MODEL=<your-openai-model-name>
# Omitted from requests when unset (some reasoning models reject it).
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Email text is truncated to this many characters before it is sent to the model.
# LLM_MAX_EMAIL_CHARS=12000
# Overrides the per-step completion token budget (defaults: classify 4096, extract/plan 8192).
# LLM_MAX_COMPLETION_TOKENS=
# Optional prices (USD per 1M tokens) used only to estimate cost in workflow_events.
# LLM_INPUT_COST_PER_1M_TOKENS=<price>
# LLM_OUTPUT_COST_PER_1M_TOKENS=<price>
#
# OpenAI (LLM_PROVIDER=openai)
# OPENAI_API_KEY=<your-openai-api-key>
# Only for OpenAI-compatible gateways/proxies; leave unset for api.openai.com.
# OPENAI_BASE_URL=https://<your-gateway-host>/v1
#
# Azure OpenAI (LLM_PROVIDER=azure_openai): endpoint, deployment and API version are required,
# plus either an API key or Microsoft Entra ID (managed identity / az login).
# AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Use a GA API version that supports structured outputs, e.g. 2024-10-21 or newer.
# AZURE_OPENAI_API_VERSION=<api-version>
# AZURE_OPENAI_API_KEY=<your-azure-openai-key>
# Preferred: keyless auth. The identity needs the "Cognitive Services OpenAI User" role.
# AZURE_OPENAI_USE_ENTRA_ID=true
# With a user-assigned managed identity, azure-identity also reads AZURE_CLIENT_ID:
# AZURE_CLIENT_ID=<your-managed-identity-client-id>

# --- Microsoft Entra ID / Microsoft Graph (docs/setup-microsoft-entra.md) ------------------------
# demo (synthetic mailbox only) | graph (real Outlook mail via Microsoft Graph)
MAIL_MODE=demo
# Tenant ID (single-tenant app) or "organizations" (multi-tenant work/school accounts).
# ENTRA_TENANT_ID=organizations
# ENTRA_CLIENT_ID=<your-app-registration-client-id>
# ENTRA_CLIENT_SECRET=<your-client-secret-value>
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# Restrict sign-in to these tenant IDs (strongly recommended for multi-tenant registrations).
# ENTRA_ALLOWED_TENANT_IDS=<your-tenant-id>
# Must exactly match a redirect URI on the app registration. Default suits Vite (:5173);
# docker-compose.yml uses http://localhost:${NUVEXA_WEB_PORT:-8080}/api/v1/auth/callback.
# OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback
# Email addresses allowed to be bootstrapped as the first tenant administrator on sign-in.
# BOOTSTRAP_ADMIN_EMAILS=<admin@your-domain.example>
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# GRAPH_TIMEOUT_SECONDS=30
# First sync window and per-sync cap.
# MAIL_SYNC_INITIAL_DAYS=14
# MAIL_SYNC_MAX_MESSAGES=200
# Per-round budgets for Graph mail sync: a round stops after the current page once it has run this long or
# holds this many body bytes, and resumes from the same page next time.
# MAIL_SYNC_ROUND_SECONDS=120
# MAIL_SYNC_MAX_BODY_BYTES=20971520
# 0 = manual "Sync mailbox" only; >0 = the worker polls connected mailboxes every N seconds.
# MAIL_POLL_INTERVAL_SECONDS=0

# --- Azure DevOps (docs/setup-azure-devops.md) --------------------------------------------------
# mock (in-memory, nothing leaves the process) | pat | entra_delegated
AZURE_DEVOPS_MODE=mock
# AZURE_DEVOPS_BASE_URL=https://dev.azure.com
# Required unless AZURE_DEVOPS_MODE=mock. The organization comes from configuration only.
# AZURE_DEVOPS_ORGANIZATION=<your-organization>
# Required for AZURE_DEVOPS_MODE=pat. Organization-scoped PAT, scope "Work Items (Read & write)".
# AZURE_DEVOPS_PAT=<your-azure-devops-pat>
# Defaults used when the tenant Settings page does not override them.
# AZURE_DEVOPS_DEFAULT_PROJECT=<your-project>
# AZURE_DEVOPS_DEFAULT_WORK_ITEM_TYPE=Task
# AZURE_DEVOPS_DEFAULT_AREA_PATH=<your-project>\<area>
# AZURE_DEVOPS_DEFAULT_ITERATION_PATH=<your-project>\<iteration>
# AZURE_DEVOPS_API_VERSION=7.1
# AZURE_DEVOPS_TIMEOUT_SECONDS=20
# AZURE_DEVOPS_MAX_RETRIES=3

# --- Worker / job queue -----------------------------------------------------------------------
# Run the job worker inside the API process (single-process setups only; compose uses a
# dedicated worker container and forces this to false).
# RUN_EMBEDDED_WORKER=false
# WORKER_POLL_INTERVAL_SECONDS=1.0
# WORKER_CONCURRENCY=4
# JOB_MAX_ATTEMPTS=3
# A running job whose lease is older than this is re-queued (worker presumed dead). Keep it well
# above the longest job duration (LLM timeouts x retries x steps).
# JOB_LEASE_SECONDS=300

# --- Telemetry (docs/observability.md) ----------------------------------------------------------
# Traces are exported only when OTEL_ENABLED=true. Structured logs go to stdout regardless.
# OTEL_ENABLED=false
# Base service name: the API reports "<OTEL_SERVICE_NAME>-api", the worker "<OTEL_SERVICE_NAME>-worker".
# OTEL_SERVICE_NAME=nuvexa
#
# Standard OpenTelemetry SDK variables (read by the SDK directly). The exporter speaks OTLP over
# HTTP/protobuf; the SDK appends /v1/traces to OTEL_EXPORTER_OTLP_ENDPOINT.
# Local OpenTelemetry Collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=<key>=<value>
#
# Langfuse (OTLP endpoint, no extra SDK). Auth string = base64("<public-key>:<secret-key>"),
# e.g.  printf '%s' 'pk-lf-...:sk-lf-...' | base64
# EU cloud: https://cloud.langfuse.com/api/public/otel   US: https://us.cloud.langfuse.com/api/public/otel
# The space after "Basic" may be written as %20 (the SDK URL-decodes header values). Langfuse also
# documents an optional x-langfuse-ingestion-version=4 header.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 public:secret>,x-langfuse-ingestion-version=4

# --- Docker Compose only (not read by the application) -----------------------------------------
# Host ports, all published on 127.0.0.1. Change them if "port is already allocated".
# APP_BASE_URL / OAUTH_REDIRECT_URI follow NUVEXA_WEB_PORT unless you set them explicitly.
# NUVEXA_WEB_PORT=8080
# NUVEXA_API_PORT=8000
# Host processes (`uv run nuvexa api`, tests) reach the compose Postgres on this port; if you change
# it, set DATABASE_URL / TEST_DATABASE_URL to the same port.
# NUVEXA_DB_PORT=5432
# POSTGRES_USER=nuvexa
# POSTGRES_PASSWORD=nuvexa
# POSTGRES_DB=nuvexa
